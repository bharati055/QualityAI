{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualityAI quarantine record",
  "type": "object",
  "additionalProperties": false,
  "required": ["test_id", "owner", "end_date", "ticket_id", "reason", "exit_criteria"],
  "properties": {
    "test_id": { "type": "string", "minLength": 1, "examples": ["CheckoutIT#shouldConfirmBooking"] },
    "owner": { "type": "string", "minLength": 1, "examples": ["@squad-payments"] },
    "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "ticket_id": {
      "type": "string",
      "pattern": "^([A-Z][A-Z0-9]{1,9}-\\d+|#\\d+|[\\w.-]+/[\\w.-]+#\\d+|https?://\\S+)$"
    },
    "reason": { "type": "string", "minLength": 10 },
    "exit_criteria": { "type": "string", "minLength": 10 },
    "mechanism": { "enum": ["disabled-annotation", "tag", "ci-skip-list"] },
    "notes": { "type": "string" }
  }
}
